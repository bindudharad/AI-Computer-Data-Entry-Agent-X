# ============================================================
# ATLAS AI - Environment configuration
# Copy to `.env` and adjust. All keys are optional.
# ============================================================

# ------------------------------------------------------------
# Vision (VLM) - the PRIMARY intelligence channel
# ------------------------------------------------------------
# Provider: "openai" | "gemini" | "local" | "mock" | "auto"
#   "auto"  = use a configured provider, else fall back to built-in
#             rule-based scene understanding (no API key required).
#   "mock"  = deterministic synthetic understanding (tests / offline).
VISION_PROVIDER=auto
VISION_MODEL=deepseek-vl2
VISION_API_KEY=
VISION_API_BASE=https://api.deepseek.com
VISION_TIMEOUT=60
VISION_CONFIDENCE_THRESHOLD=0.4

# ------------------------------------------------------------
# Reasoning (LLM) - action planning
# ------------------------------------------------------------
REASONING_PROVIDER=auto
REASONING_MODEL=deepseek-reasoner
REASONING_API_KEY=
REASONING_API_BASE=https://api.deepseek.com
REASONING_TIMEOUT=60
REASONING_CONFIDENCE_THRESHOLD=0.5

# ------------------------------------------------------------
# OCR fallback (only used on explicit AI request)
# ------------------------------------------------------------
OCR_ENGINE=paddle          # paddle | tesseract | none
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.4

# ------------------------------------------------------------
# Mouse behaviour (human-like)
# ------------------------------------------------------------
MOUSE_BEZIER_STEPS=35
MOUSE_SPEED=0.35
MOUSE_MIN_DELAY=0.05
MOUSE_MAX_DELAY=0.25
MOUSE_PAUSE_BEFORE_CLICK=0.08
MOUSE_PAUSE_AFTER_CLICK=0.10
MOUSE_JITTER_PX=3
MOUSE_DOUBLE_CLICK_INTERVAL=0.30

# ------------------------------------------------------------
# Typing behaviour (human-like)
# ------------------------------------------------------------
TYPING_MIN_DELAY=0.05
TYPING_MAX_DELAY=0.25
TYPING_PAUSE_AFTER=0.15
TYPING_USE_CLIPBOARD_FOR_LONG=true
TYPING_CLIPBOARD_MIN_LENGTH=25
TYPING_SIMULATE_TYPOS=true
TYPING_TYPO_RATE=0.02

# ------------------------------------------------------------
# Observation
# ------------------------------------------------------------
OBSERVE_POLL_INTERVAL=0.8
OBSERVE_CAPTURE_FORMAT=png
OBSERVE_SCREENSHOT_DIR=screenshots

# ------------------------------------------------------------
# Agent workflow
# ------------------------------------------------------------
WORKFLOW_VERIFY_AFTER_ACTION=true
WORKFLOW_MAX_RETRIES_PER_ACTION=3
WORKFLOW_RETRY_DELAY=0.8
WORKFLOW_NEXT_RECORD_TIMEOUT=120
WORKFLOW_NEXT_RECORD_POLL=1.5
WORKFLOW_MAX_RECORDS=0
WORKFLOW_LOG_SCREENSHOTS=true
# Fill the visible viewport first, then scroll down to reveal and fill
# below-the-fold fields before submitting once (human data-entry behaviour).
WORKFLOW_SCAN_REVEAL_FIELDS=true

# ------------------------------------------------------------
# Assistant overlay
# ------------------------------------------------------------
OVERLAY_ENABLED=true
OVERLAY_ANIMATION_FPS=30
OVERLAY_COMMAND_PORT=19765
CONTROLLER_COMMAND_PORT=19768

# ------------------------------------------------------------
# Memory
# ------------------------------------------------------------
MEMORY_DB_PATH=memory.db
MEMORY_ALIAS_LEARNING=true

# ------------------------------------------------------------
# Debug
# ------------------------------------------------------------
DEBUG_MODE=false
LOG_LEVEL=DEBUG
LOG_FOLDER=logs
